# --- Pakolliset ---
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=

# --- Valinnaiset ---
# PageSpeed-auditointi (toimii ilmankin, mutta avaimella isompi kiintiö)
PAGESPEED_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Mihin demot julkaistaan. Demo löytyy osoitteesta DEMO_BASE_URL/<slug>/
DEMO_BASE_URL=https://demo.hunmedia.fi
# Julkaisu: "git" = pushaa demos-kansion GitHubiin, Vercel julkaisee automaattisesti.
# Voit laittaa myös oman komennon, esim. npx vercel deploy demos --prod --yes
DEPLOY_CMD=git

# Kuinka monta demoa rakennetaan per kierros (API-kulut!)
BUILDS_PER_RUN=5
# Olemassa olevan sivun auditointipisteraja: tätä huonommat sivut = liidi
AUDIT_THRESHOLD=45

# --- Lähettäjä ja sähköposti ---
SENDER_NAME=
SENDER_PHONE=
SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAX_SENDS_PER_RUN=10
